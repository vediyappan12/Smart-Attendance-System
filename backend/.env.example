# Copy this file to .env and change the sample values before starting the server.
DB_USER=attendance_user
DB_PASSWORD=replace-with-your-mysql-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=attendance_db
# Leave blank to use the DB_* MySQL settings above. For local-only development,
# you can instead use DATABASE_URL=sqlite:///./attendance.db.
DATABASE_URL=

# Internal signing secret for short-lived admin session tokens. Do not use as a login password.
ADMIN_API_KEY=replace-with-a-long-random-signing-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password

# Required only if using optional face enrollment. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=

WORK_START_TIME=09:30:00
GRACE_PERIOD_MINUTES=15
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
